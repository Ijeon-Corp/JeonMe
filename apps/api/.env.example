APP_ENV=local
APP_PORT=8080

# Format: postgres://user:password@host:5432/dbname?sslmode=disable
DATABASE_URL=postgres://jeonme:jeonme@localhost:5432/jeonme?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Ganti dengan random string panjang di production (mis. openssl rand -hex 32)
JWT_SECRET=ganti-dengan-secret-yang-panjang-dan-acak

# Isi setelah daftar akun Xendit (mode sandbox dulu untuk development)
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_VERIFICATION_TOKEN=

CORS_ALLOWED_ORIGINS=http://localhost:3000

# Object storage (MinIO self-hosted, S3-compatible) untuk file produk digital.
# Lokal (docker-compose.yml): endpoint localhost:9000, kredensial jeonme/jeonme12345.
#
# Staging/production: S3_ENDPOINT diisi domain PUBLIK (storage-staging.jeonme.com
# / storage.jeonme.com, diproxy Apache dengan TLS ke port lokal MinIO -- lihat
# bug #14 katalog CICD-GUIDE.md), BUKAN "minio:9000" internal Docker -- signed
# download URL (REQ-F-304) harus bisa diakses dari luar VPS, bukan cuma dari
# jaringan Docker internal. S3_USE_SSL=true untuk keduanya.
# MINIO_ROOT_USER/PASSWORD di .env VPS dipakai langsung sebagai
# S3_ACCESS_KEY/S3_SECRET_KEY -- ganti passwordnya, jangan pakai nilai contoh ini.
# PENTING: S3_ENDPOINT tanpa skema (BUKAN "https://storage.jeonme.com") --
# minio-go menolak endpoint yang mengandung skema. Atur http/https lewat S3_USE_SSL.
MINIO_ROOT_USER=jeonme
MINIO_ROOT_PASSWORD=jeonme12345
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=jeonme
S3_SECRET_KEY=jeonme12345
S3_BUCKET=jeonme-products
S3_USE_SSL=false
