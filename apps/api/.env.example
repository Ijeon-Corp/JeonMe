APP_ENV=local
APP_PORT=8080

# Format: postgres://user:password@host:5432/dbname?sslmode=disable
DATABASE_URL=postgres://jeonme:jeonme@localhost:5432/jeonme?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Ganti dengan random string panjang di production (mis. openssl rand -hex 32)
JWT_SECRET=ganti-dengan-secret-yang-panjang-dan-acak

# Isi setelah daftar akun Midtrans (mode sandbox dulu untuk development).
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# Login/daftar via Google (alur Authorization Code, lihat
# internal/googleoauth) -- dari Google Cloud Console > APIs & Services >
# Credentials > OAuth client ID (tipe "Web application"). Authorized
# redirect URI HARUS didaftarkan persis: http://localhost:3000/auth/google/callback
# (dev) dan https://jeon.id/auth/google/callback (production, domain kanonik
# sejak migrasi 18 Agustus 2026 -- daftarkan JUGA https://jeonme.com/auth/
# google/callback selama domain lama itu masih menerima traffic langsung
# sebelum redirect 301-nya sempat diikuti browser). Kosongkan
# kalau belum ada kredensial -- POST /auth/google akan membalas 501 yang
# jelas, bukan mengganggu login/register biasa. NEXT_PUBLIC_GOOGLE_CLIENT_ID
# di apps/web/.env.local HARUS diisi nilai CLIENT_ID yang SAMA persis.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Login/daftar via Apple ("Sign in with Apple", lihat internal/appleoauth)
# -- SEMUANYA dari situs Apple Developer (apps.apple.com/account, WAJIB
# member Apple Developer Program berbayar, beda dari Google Cloud Console
# yang gratis):
#   1. Certificates, Identifiers & Profiles > Identifiers > "+" > Services
#      IDs -- daftarkan identifier baru (mis. "id.jeon.web", BUKAN bundle ID
#      app kalau ada app iOS terpisah). Ini nilai APPLE_CLIENT_ID.
#   2. Di Services ID itu, aktifkan "Sign in with Apple" > Configure --
#      Primary App ID diisi App ID utama akun developer, "Domains and
#      Subdomains" diisi jeon.id + staging.jeon.id, "Return URLs" diisi
#      PERSIS https://jeon.id/auth/apple/callback dan
#      https://staging.jeon.id/auth/apple/callback -- Apple TIDAK
#      mengizinkan localhost/http:// di sini (beda dari Google), jadi Apple
#      login praktis tidak bisa dites dari localhost, hanya staging/prod.
#   3. Certificates, Identifiers & Profiles > Keys > "+" -- centang "Sign in
#      with Apple", associate ke App ID utama, buat. Unduh file .p8 yang
#      muncul SEKALI SAJA (tidak bisa diunduh ulang, simpan baik-baik) --
#      isinya jadi APPLE_PRIVATE_KEY. Key ID 10 karakter yang ditampilkan
#      saat itu jadi APPLE_KEY_ID.
#   4. Team ID (10 karakter, di Membership pojok kanan atas akun developer)
#      jadi APPLE_TEAM_ID.
# APPLE_PRIVATE_KEY: isi file .p8 (format PEM PKCS8) HARUS satu baris --
# ganti newline sungguhan dengan "\n" literal saat menempel di sini (kode
# menormalisasi balik otomatis, lihat appleoauth.Client.parsePrivateKey).
# Kosongkan kalau belum ada kredensial -- POST /auth/apple akan membalas
# 501 yang jelas. NEXT_PUBLIC_APPLE_CLIENT_ID di apps/web/.env.local HARUS
# diisi nilai APPLE_CLIENT_ID (Services ID) yang SAMA persis.
APPLE_TEAM_ID=
APPLE_CLIENT_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Blokir tautan sensitif (judi online/18+) -- permintaan langsung pengguna,
# 22 Agustus 2026: "sistem bisa memblokir jika memasukkan link yang
# sensitif contoh nya link judol link 18+ dll" (lihat internal/moderation &
# handlers.LinkModerationChecker). Blocklist domain/kata kunci (dikelola
# lewat panel admin) berlaku SELALU, terlepas dari key ini. Key ini HANYA
# mengaktifkan lapisan KEDUA -- klasifikasi Claude API untuk domain yang
# belum pernah dilihat & tidak cocok kata kunci mana pun. Kosongkan kalau
# belum punya API key (console.anthropic.com) -- lapis AI dilewati diam-
# diam, blocklist deterministik tetap jalan seperti biasa.
ANTHROPIC_API_KEY=

# Koneksi Sosial Instagram/TikTok (Modul Koneksi Sosial, migrasi 000069,
# permintaan langsung pengguna 17 Agustus 2026: "saya mau jeonme ini bisa
# connect ke akun kita contoh nya instagram tiktok") -- profil + 6
# postingan/video TERBARU kreator tampil otomatis di halaman publiknya
# begitu terhubung, ala fitur "Connect Instagram/TikTok" Linktree.
#
# Instagram: daftar app "Instagram API with Instagram Login" di
# developers.facebook.com/apps (BUKAN app Facebook Login biasa), scope
# instagram_business_basic, akun Instagram kreator WAJIB Professional
# (Creator/Business). Redirect URI HARUS didaftarkan persis:
# http://localhost:3000/auth/instagram/callback (dev) dan
# https://jeon.id/auth/instagram/callback (production, domain kanonik --
# daftarkan JUGA https://jeonme.com/auth/instagram/callback selama transisi).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# TikTok: daftar app di developers.tiktok.com, produk "Login Kit" + scope
# user.info.basic, video.list. Redirect URI HARUS didaftarkan persis:
# http://localhost:3000/auth/tiktok/callback (dev) dan
# https://jeon.id/auth/tiktok/callback (production, domain kanonik --
# daftarkan JUGA https://jeonme.com/auth/tiktok/callback selama transisi).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Kosongkan salah satu/keduanya kalau belum ada kredensial -- endpoint
# /dashboard/social-connect/{instagram,tiktok} akan membalas 501 yang
# jelas, tidak mengganggu fitur lain (soft-fail, lihat internal/
# instagramoauth & internal/tiktokoauth).

CORS_ALLOWED_ORIGINS=http://localhost:3000

# SMTP -- awalnya cuma notifikasi email pembeli (REQ-F-405, dikirim lewat
# `./api worker`), TAPI sejak 19 Agustus 2026 JUGA satu-satunya jalur
# kirim kode aktivasi akun baru (lihat AuthHandler.Register/
# ConfirmSignupVerification) -- kalau APP_ENV=production DAN variabel ini
# kosong, worker cuma log-only (soft-fail, pola sama seperti sebelumnya)
# TAPI TIDAK ADA fallback dev_verification_code di respons API pada
# production (itu HANYA muncul saat APP_ENV != production) -- akibatnya
# TIDAK ADA SATU PUN akun baru yang bisa menyelesaikan aktivasi, registrasi
# sungguhan berhenti total. WAJIB terisi kredensial asli sebelum rilis
# production dengan fitur ini aktif -- beda dari sebelumnya yang memang
# aman dikosongkan.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@jeon.id

# WhatsApp Business Cloud API (Meta) -- kanal notifikasi TAMBAHAN untuk
# pembeli (No.74, Sprint 8; email di atas tetap kanal wajib). Kosongkan
# kalau belum ada kredensial, worker akan log-only (pola sama seperti SMTP
# di atas) -- KEPUTUSAN BISNIS (verifikasi bisnis Meta, nomor terdaftar,
# template pesan disetujui) BELUM diambil, lihat internal/whatsapp/client.go.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=order_confirmation
WHATSAPP_TEMPLATE_LANG=id

# Object storage (MinIO self-hosted, S3-compatible) untuk file produk digital.
# Lokal (docker-compose.yml): endpoint localhost:9000, kredensial jeonme/jeonme12345.
#
# Staging/production: S3_ENDPOINT diisi domain PUBLIK (storage-staging.jeon.id
# / storage.jeon.id, diproxy Apache dengan TLS ke port lokal MinIO -- lihat
# bug #14 katalog CICD-GUIDE.md), BUKAN "minio:9000" internal Docker -- signed
# download URL (REQ-F-304) harus bisa diakses dari luar VPS, bukan cuma dari
# jaringan Docker internal. S3_USE_SSL=true untuk keduanya.
# MINIO_ROOT_USER/PASSWORD di .env VPS dipakai langsung sebagai
# S3_ACCESS_KEY/S3_SECRET_KEY -- ganti passwordnya, jangan pakai nilai contoh ini.
# PENTING: S3_ENDPOINT tanpa skema (BUKAN "https://storage.jeon.id") --
# minio-go menolak endpoint yang mengandung skema. Atur http/https lewat S3_USE_SSL.
MINIO_ROOT_USER=jeonme
MINIO_ROOT_PASSWORD=jeonme12345
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=jeonme
S3_SECRET_KEY=jeonme12345
S3_BUCKET=jeonme-products
S3_USE_SSL=false
