# Dipakai oleh docker-compose.staging.yml / docker-compose.prod.yml di VPS.
# JANGAN commit file .env asli ke git.

# Harus persis "owner/repo" GitHub (huruf kecil semua -- GHCR selalu
# lowercase), sama seperti yang dipakai ci.yml lewat ${{ github.repository }}.
# Contoh: GHCR_REPO=akbaroktaviadi89/jeonme
GHCR_REPO=

IMAGE_TAG=latest

# Port di HOST (VPS) yang di-bind HANYA ke 127.0.0.1 -- lihat komentar di atas
# docker-compose.staging.yml / docker-compose.prod.yml. Wajib beda per
# environment kalau staging & production berbagi satu VPS yang sama.
# Apache/Nginx di level sistem yang mem-proxy domain publik ke port ini.
WEB_HOST_PORT=3000
API_HOST_PORT=8080

APP_ENV=production
APP_PORT=8080
DATABASE_URL=postgres://jeonme:CHANGE_ME@db:5432/jeonme?sslmode=disable
POSTGRES_USER=jeonme
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=jeonme
REDIS_URL=redis://redis:6379/0

JWT_SECRET=CHANGE_ME_random_long_string

# Modul Settings §3 (AES-256-GCM, lihat internal/crypto): enkripsi nomor
# rekening/e-wallet payout_methods at rest. WAJIB PERSIS 32 byte -- fail-fast
# (log.Fatalf) begitu APP_ENV=production, lihat config.go. Generate dengan
# `openssl rand -hex 16` (menghasilkan string hex 32 karakter = 32 byte).
# JANGAN diganti setelah diisi -- payout_methods yang sudah terenkripsi
# dengan key lama tidak akan bisa didekripsi lagi.
ENCRYPTION_KEY=CHANGE_ME_persis_32_byte_string

# Isi setelah daftar akun Midtrans (mode sandbox dulu). MIDTRANS_IS_PRODUCTION
# HARUS "true" di production -- server key sandbox & production tidak bisa
# dipakai silang (Midtrans menolak dengan 401).
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false

# SMTP -- notifikasi email pembeli (REQ-F-405) DAN (sejak 19 Agustus 2026)
# kode aktivasi akun baru saat signup -- lihat catatan lengkap & peringatan
# WAJIB terisi di production di apps/api/.env.example. Kosong di production
# berarti registrasi baru berhenti total, bukan cuma notifikasi yang hilang.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@jeon.id

# jeon.id adalah domain produksi kanonik sejak migrasi 18 Agustus 2026 --
# jeonme.com TETAP terdaftar & redirect 301 ke sini (bukan didekomisi), jadi
# tambahkan juga origin itu di CORS_ALLOWED_ORIGINS produksi sungguhan
# (dipisah koma) supaya request lama yang belum sempat redirect tetap lolos.
CORS_ALLOWED_ORIGINS=https://jeon.id
NEXT_PUBLIC_API_BASE_URL=https://jeon.id/api/v1
